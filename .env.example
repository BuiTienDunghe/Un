LOG_DIR=data/logs
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_TIMEOUT_SECONDS=120
OLLAMA_HEALTH_TIMEOUT_SECONDS=5
QDRANT_URL=http://127.0.0.1:6333
MAX_UPLOAD_SIZE_BYTES=52428800
DATABASE_URL=postgresql+psycopg://local_ai:change-me@127.0.0.1:5432/local_ai_core
# Windows host scripts use 127.0.0.1. Compose containers use the service host:
# DATABASE_URL=postgresql+psycopg://local_ai:change-me@postgres:5432/local_ai_core
CONTAINER_DATABASE_URL=postgresql+psycopg://local_ai:change-me@postgres:5432/local_ai_core
REQUEST_LOG_RETENTION_DAYS=7
INGESTION_EXECUTION_BACKEND=thread
REDIS_URL=redis://127.0.0.1:6379/0
RQ_QUEUE_PREFIX=local-ai:dev
# Bật true để chạy chế độ đề xuất (P1-3): mỗi lượt Discord đủ điều kiện sinh
# một candidate memory chờ duyệt — không gì tự áp dụng. Khi bật, launcher tự
# khởi động thêm outbox dispatcher + memory worker và pull model extractor.
DISCORD_MEMORY_INGESTION_ENABLED=false
DISCORD_MEMORY_EXTRACTOR_ENABLED=false
DISCORD_MEMORY_EXTRACTOR_MODEL=qwen3.5:9b
DISCORD_MEMORY_EXTRACTOR_SCHEMA_VERSION=v1
DISCORD_MEMORY_EXTRACTOR_NUM_CTX=4096
DISCORD_MEMORY_EXTRACTOR_TEMPERATURE=0.0
DISCORD_MEMORY_EXTRACTOR_SEED=424242
DISCORD_MEMORY_EXTRACTOR_JSON_FALLBACK=false
DISCORD_MEMORY_EXTRACTOR_TIMEOUT_SECONDS=60
DISCORD_MEMORY_EXTRACTOR_RETRY_COUNT=1
DISCORD_MEMORY_QUEUE_NAME=memory_extract
# Retry/timeout của các client cục bộ (mặc định trong settings.py).
OLLAMA_RETRY_COUNT=2
QDRANT_TIMEOUT_SECONDS=10
MAX_MESSAGE_LENGTH=10000
CONVERSATION_HISTORY_LIMIT=12
JOB_MAX_ATTEMPTS=3
JOB_STALE_TIMEOUT_SECONDS=900
SUPERSEDED_VERSION_GRACE_DAYS=7
# Directory used by the backup scripts; retain it outside the project volume.
BACKUP_DIR=data/backups
POSTGRES_DB=local_ai_core
POSTGRES_USER=local_ai
POSTGRES_PASSWORD=change-me
# ── Truy cập (P0-2) ───────────────────────────────────────────────────────────
# Để trống = không bật xác thực: mọi endpoint mở, đúng cho máy cá nhân.
# Đặt một chuỗi ngẫu nhiên dài để yêu cầu header X-API-Key ở mọi endpoint ghi/xóa.
# Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Nhập cùng khóa đó vào giao diện web: Cài đặt → Bảo mật.
LOCAL_AI_API_KEY=
# true = khóa cả endpoint đọc (trừ /health và /models). Chỉ dùng khi mở cho LAN.
LOCAL_AI_PROTECT_READS=false

DISCORD_TOKEN=
DISCORD_CLIENT_ID=1522310732912398527
DISCORD_INVITE_URL=https://discord.com/oauth2/authorize?client_id=1522310732912398527
LOCAL_AGENT_BASE_URL=http://api:8000
LOCAL_AGENT_USERNAME=
LOCAL_AGENT_PASSWORD=
DISCORD_MEMBER_CONTEXT_LIMIT=100
# Phiên hội thoại Discord lưu bền trong PostgreSQL (bot nhớ ngữ cảnh qua restart).
DISCORD_PERSISTENT_SESSIONS_ENABLED=true
# Ordinary backend calls keep a short timeout; model execution gets a separate
# timeout longer than OLLAMA_CHAT_TIMEOUT_SECONDS.
DISCORD_BACKEND_TIMEOUT_SECONDS=45
DISCORD_TURN_EXECUTE_TIMEOUT_SECONDS=180
# Text/announcement channel where the local control panel posts bot status.
# Keep the real channel ID in .env or the panel's gitignored local settings.
DISCORD_STATUS_CHANNEL_ID=
# Optional host-only override for the Windows control panel.
DISCORD_CONTROL_BACKEND_URL=http://127.0.0.1:8000

# ── Cloud LLM API Keys ────────────────────────────────────────────────────────
# Set the provider in backend/app/config/models.yaml then add the key here.
# Only the provider you are using needs a key; unused ones can be left blank.

# Google Gemini – get key at: https://aistudio.google.com/apikey
# Supported models: gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro
GEMINI_API_KEY=
GEMINI_CHAT_TIMEOUT_SECONDS=60
GEMINI_RETRY_COUNT=2

# DeepSeek – get key at: https://platform.deepseek.com/api_keys
# Supported models: deepseek-chat (V3/V4), deepseek-reasoner (R1)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_TIMEOUT_SECONDS=90
DEEPSEEK_RETRY_COUNT=2

# ── P3-1: Che do tai khoan (admin/member) ─────────────────────────────
# Bat len khi muon dua link cho nhieu nguoi dung. BAT BUOC kem:
#  - LOCAL_AI_JWT_SECRET: chuoi ngau nhien >= 32 ky tu
#  - LOCAL_AI_API_KEY: khoa dich vu cho bot Discord / eval / smoke test
# Nguoi dung DAU TIEN dang ky (man hinh web) la quan tri vien; sau do
# quan tri vien tao tai khoan cho nguoi khac ngay tren API /auth/users.
LOCAL_AI_AUTH_ENABLED=false
LOCAL_AI_JWT_SECRET=
LOCAL_AI_ACCESS_TOKEN_MINUTES=15
LOCAL_AI_REFRESH_TOKEN_DAYS=14
