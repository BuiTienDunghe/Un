LOG_DIR=data/logs
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_TIMEOUT_SECONDS=120
OLLAMA_HEALTH_TIMEOUT_SECONDS=5
QDRANT_URL=http://127.0.0.1:6333
MAX_UPLOAD_SIZE_BYTES=52428800
DATABASE_URL=postgresql+psycopg://local_ai:change-me@127.0.0.1:5432/local_ai_core
# Windows host scripts use 127.0.0.1. Compose containers use the service host:
# DATABASE_URL=postgresql+psycopg://local_ai:change-me@postgres:5432/local_ai_core
CONTAINER_DATABASE_URL=postgresql+psycopg://local_ai:change-me@postgres:5432/local_ai_core
REQUEST_LOG_RETENTION_DAYS=7
INGESTION_EXECUTION_BACKEND=thread
REDIS_URL=redis://127.0.0.1:6379/0
RQ_QUEUE_PREFIX=local-ai:dev
OCR_WORKER_CONCURRENCY=1
INDEX_WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_STALE_TIMEOUT_SECONDS=900
SUPERSEDED_VERSION_GRACE_DAYS=7
# Directory used by the backup scripts; retain it outside the project volume.
BACKUP_DIR=data/backups
POSTGRES_DB=local_ai_core
POSTGRES_USER=local_ai
POSTGRES_PASSWORD=change-me
