    "abstain": [
      {
        "q": "Số tài khoản ngân hàng là gì?",
        "answer": "Dựa trên văn bản được cung cấp, thông tin về **số tài khoản ngân hàng** không có trong nội dung của hóa đơn này. Văn bản chỉ nêu rõ phương thức thanh toán là \"Chuyển khoản\" nhưng không liệt kê số tài khoản cụ thể."
      },
      {
        "q": "Số điện thoại của người nhận là gì?",
        "answer": "Dựa trên văn bản được cung cấp, thông tin về số điện thoại của người nhận (Phạm Ngọc Quỳnh) **không có** trong nội dung này. Văn bản chỉ ghi rõ họ tên người nhận mà không đề cập đến số điện thoại."
      },
      {
        "q": "Số điện thoại của người chủ trì là gì?",
        "answer": "Dựa trên văn bản được cung cấp, thông tin về số điện thoại của người chủ trì (Đặng Khánh Huyền) **không có** trong nội dung. Văn bản chỉ ghi rõ họ tên, mã lịch, thời gian, địa điểm và email liên hệ."
      },
      {
        "q": "Số tài khoản nhận phụ cấp của NV-84 là gì?",
        "answer": "Dựa trên văn bản được cung cấp, không có thông tin về số tài khoản nhận phụ cấp của NV-84. Văn bản chỉ liệt kê mã nhân viên, bộ phận và số tiền phụ cấp."
      }
    ]
  },
